<Project>
  <PropertyGroup>
    <RootFolder>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory),'..','..','..','..','..'))</RootFolder>
    <BinFolder>$(RootFolder)\Bin</BinFolder>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'!='Debug'">
    <PackagesFolder>$(RootFolder)\Packages</PackagesFolder>
    <OutputPath>$(BinFolder)\$(Company)\$(AssemblyName)\$(VersionPrefix)</OutputPath>
	<RemotePackagesFolder>\\SVR001\Desenvolvimento\Projetos\Packages</RemotePackagesFolder>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Publish'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <Target Name="AddPackageToFeed" AfterTargets="Pack" Condition="'$(Configuration)'=='Publish'" >
    <PropertyGroup>
      <PackageFile>$(OutputPath)$(PackageId).$(PackageVersion).nupkg</PackageFile>
    </PropertyGroup>
    
    <Message Text="Cleaning current build of package $(PackageId) version $(PackageVersion) on $(PackagesFolder)" Importance="high"/>
    <Exec Command="nuget delete &quot;$(PackageId)&quot; &quot;$(PackageVersion)&quot; -Source &quot;$(PackagesFolder)&quot; -NonInteractive" ContinueOnError="WarnAndContinue"/>

    <Message Text="Install package $(PackageFile) to $(PackagesFolder)" Importance="high"/>
    <Exec Command="nuget add &quot;$(PackageFile)&quot; -Source &quot;$(PackagesFolder)&quot; -Expand"/>
	<Exec Command="copy &quot;$(PackageFile)&quot; &quot;$(PackagesFolder)&quot;"/>
	<Exec Command="copy &quot;$(PackageFile)&quot; &quot;$(RemotePackagesFolder)&quot;"/>
  </Target>
</Project>