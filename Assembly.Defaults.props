<Project>
  
  <PropertyGroup>
    <Title Condition="$(Title)==''">$(AssemblyName)</Title> 
    <Product Condition="$(Product)==''">$(AssemblyName)</Product>
  </PropertyGroup>

   <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>

    <None Include="$(RootFolder)\Resources\Fazsoft\Images\FazsoftLogo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>